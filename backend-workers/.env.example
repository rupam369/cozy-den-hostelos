# --- Supabase Database & Storage Connection ---
SUPABASE_URL=https://lpektepedttwesoeacbx.supabase.co
# Service Role Key (Required for worker admin queries & RLS bypass)
# Locate in: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# Anon Key (Fallback for public queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- OpenAI AI Assistant (Optional) ---
# If provided, powers ChatGPT-based responses in /chat endpoint
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# --- API Security & Rate Limiting ---
# Set to protect /search-memory and /trigger-escalation with X-API-KEY header
BACKEND_API_KEY=cozy_den_secret_worker_api_key_2026
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=60

# --- DreamCast PicBot Parameters ---
# Cosine similarity cutoff for facial recognition matching (0.0 to 1.0)
FACE_MATCH_THRESHOLD=0.72
STORAGE_MEMORIES_BUCKET=hostel-memories
DREAMCAST_POLL_INTERVAL_SECONDS=60

# --- Complaint Escalation Automation ---
# Threshold in hours before an unresolved complaint triggers a RED ALERT
ESCALATION_HOURS_THRESHOLD=48
ESCALATION_CHECK_INTERVAL_SECONDS=300

# --- Server Runtime ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
